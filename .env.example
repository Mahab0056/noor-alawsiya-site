# Postgres connection string. Leave empty on your own machine to use the local PGlite database in .pglite/
DATABASE_URL=
# At least 32 random characters. Keys the admins' login codes. Required in production.
APP_SECRET=
# Origin used in links inside e-mails (admin invites; never taken from the request). Production: https://noor-alawsiya.com
APP_ORIGIN=
# Resend sending-only key (re_…), for the admin login codes and invites. Set on Railway by the operator, never here.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "نور الأوصياء <noreply@mail.noor-alawsiya.com>". Required in production.
EMAIL_FROM=
# Daily digest to the super admins (lib/admin-digest.ts). Off unless 1. See README «الملخص اليومي للمديرين».
ADMIN_DIGEST=
# Bearer token for POST /api/cron/admin-digest (32+ random characters). Only needed to call the URL; npm run digest needs none.
ADMIN_DIGEST_TOKEN=
