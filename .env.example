# Postgres connection string. Leave empty on your own machine to use the local PGlite database in .pglite/
DATABASE_URL=
# At least 32 random characters. Encrypts the admins' two-step secrets. Required in production.
APP_SECRET=
# Origin used in links inside e-mails (never taken from the request). Production: https://noor-alawsiya.com
APP_ORIGIN=
# Resend sending-only key (re_…). Set on Railway with C:\nyl\org\for-mahab\set-awsiya-resend-key.ps1, never here.
RESEND_API_KEY=
# Sender. Until noor-alawsiya.com is verified in Resend: نور الأوصياء <no-reply@barmjini.com>
MAIL_FROM=
