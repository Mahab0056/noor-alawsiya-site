# Postgres connection string. Leave empty on your own machine to use the local PGlite database in .pglite/
DATABASE_URL=
# At least 32 random characters. Keys the e-mailed sign-in codes (and the authenticator secrets if ADMIN_TOTP=1). Required in production.
APP_SECRET=
# Origin used in links inside e-mails (never taken from the request). Production: https://noor-alawsiya.com
APP_ORIGIN=
# Resend sending-only key (re_…). Set on Railway by the operator, never here.
RESEND_API_KEY=
# Sender (a verified Resend domain). Default: Noor Al-Awsiya <noreply@mail.noor-alawsiya.com>. MAIL_FROM is read as an older name.
EMAIL_FROM=
# 1 = admins use an authenticator app (QR at invite, app code at sign-in). Empty (default) = a code by e-mail on each new device.
ADMIN_TOTP=
