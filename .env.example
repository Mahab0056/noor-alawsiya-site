# Postgres connection string. Leave empty on your own machine to use the local PGlite database in .pglite/
DATABASE_URL=
# At least 32 random characters. Keys the admins' login codes. Required in production.
APP_SECRET=
# Resend API key, for the admin login codes. Required in production.
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "نور الأوصياء <no-reply@mail.example.com>"
EMAIL_FROM=
